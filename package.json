{
  "name": "@avgeek-oss/country-data",
  "version": "0.1.1",
  "description": "Offline country reference data, localized names, flags, and typed lookups for JavaScript applications.",
  "type": "module",
  "license": "(MIT AND ODbL-1.0 AND Unicode-3.0)",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./data": "./dist/countries.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "LICENSE-DATA", "LICENSE-UNICODE", "NOTICE.md"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "https://github.com/avgeek-oss/pkg-country-data.git" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:published": "node scripts/test-package.mjs --published",
    "verify": "npm run typecheck && npm test && npm run test:package",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
